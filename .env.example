# Live mode needs a Claude API key; without one the factory runs offline in mock mode.
ANTHROPIC_API_KEY=
# mock | live (defaults to live when a key is present)
WORKHOUSE_MODE=
# Model for the agents (default claude-opus-5); optional separate model for reviewers and the gate
WORKHOUSE_MODEL=claude-opus-5
WORKHOUSE_REVIEW_MODEL=
# Spend caps in USD: per tick and total before the factory pauses and asks you
WORKHOUSE_MAX_TICK_COST_USD=2
WORKHOUSE_MAX_TOTAL_COST_USD=50
# Seconds between ticks when auto-running
WORKHOUSE_TICK_SECONDS=600
# Money the company may commit without asking (cents); 0 = always ask
WORKHOUSE_AUTONOMOUS_SPEND_CENTS=0
# Where the operator profile lives (copy operator.example.json)
WORKHOUSE_OPERATOR_PROFILE=operator.json
WORKHOUSE_DB=workhouse.db
WORKHOUSE_PORT=8787
